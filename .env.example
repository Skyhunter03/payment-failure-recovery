# Copy to .env and fill in. NEVER commit .env.
#
# Get this from the Razorpay Dashboard in TEST MODE:
#   Settings -> Webhooks -> (your webhook) -> Secret
# It is the secret you typed when creating the webhook, NOT your API key.
RAZORPAY_WEBHOOK_SECRET=whsec_replace_me

# Test-mode API keys, used ONLY by the /create-order checkout helper (not the
# webhook service). From the Razorpay Dashboard (test mode) -> Settings -> API Keys.
# key_id is safe to expose; key_secret is secret — it stays server-side.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Port the service listens on.
PORT=3000

# Where the SQLite file lives. Directory is created if missing. Only used
# when DATABASE_URL (below) is unset.
DB_PATH=./data/recovery.sqlite

# Postgres connection string (Neon free tier, or any Postgres). When set, the
# service uses Postgres instead of SQLite — this is what production (Render)
# should have. Leave unset for local dev to use the SQLite fallback instead.
# NEVER commit a real value — env only (.env locally, host dashboard in prod).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Set to "false" to disable the in-process follow-up ticker (it only logs,
# it never contacts anyone). Default: true.
FOLLOWUP_TICKER=true

# How often (ms) the follow-up ticker checks for due nudges. Default 60000.
FOLLOWUP_TICK_MS=60000
